<%- include('../partials/header') %>

    <div class="container mt-4">
        <h2>Your Notes</h2>

        <a href="/notes/new" class="btn btn-primary mb-3">New Note</a>

        <% if (notes.length===0) { %> <!-- if there are no notes, show message -->
            <p>No notes yet.</p>
            <% } else { %>
                <ul class="list-group">
                    <% notes.forEach(note=> { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <%= note.title %> -
                                <%= note.content %>
                            </span>

                            <div>
                                <a href="/notes/<%= note._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>

                                <form action="/notes/<%= note._id %>?_method=DELETE" method="POST"
                                    style="display:inline;">
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                </ul>
                <% } %>
    </div>

    <%- include('../partials/footer') %>